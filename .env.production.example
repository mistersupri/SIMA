# Isi nilai di bawah, simpan sebagai .env di samping docker-compose.prod.yml.
# Buat secret acak:  openssl rand -base64 48

# URL publik aplikasi (HTTPS wajib; masuk ke isi QR Code)
APP_URL=https://sima.contoh.go.id

# Database internal (di dalam container, tidak terbuka ke luar)
POSTGRES_PASSWORD=GANTI-dengan-sandi-acak-panjang

# Sesi
SESSION_SECRET=GANTI-dengan-string-acak-minimal-32-karakter

# Akun Super Admin pertama (wajib ganti sandi saat login pertama)
BOOTSTRAP_ADMIN_EMAIL=admin@instansi.go.id
BOOTSTRAP_ADMIN_PASSWORD=GANTI-Sandi-Awal-Yang-Kuat-123

# Opsional
ORG_CODE=INSTANSI
ORG_NAME=Nama Instansi Anda
