# Salin ke .env di server produksi, isi semua nilai bertanda GANTI, lalu:
#   docker compose -f docker-compose.prod.yml up -d --build
# Buat secret acak:  openssl rand -base64 48

# Domain publik (Caddy mengurus sertifikat HTTPS otomatis). Untuk uji lokal: localhost
DOMAIN=sima.contoh.go.id
APP_URL=https://sima.contoh.go.id

# Database (hanya dijangkau jaringan internal Docker)
POSTGRES_USER=sima
POSTGRES_PASSWORD=GANTI-dengan-sandi-acak-panjang
POSTGRES_DB=sima

# Sesi dan keamanan
SESSION_SECRET=GANTI-dengan-string-acak-minimal-32-karakter
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MAX_UPLOAD_MB=10

# Akun Super Admin pertama (dibuat seed bila belum ada; wajib ganti sandi saat login pertama)
ORG_CODE=INSTANSI
ORG_NAME=Nama Instansi Anda
BOOTSTRAP_ADMIN_EMAIL=admin@instansi.go.id
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_PASSWORD=GANTI-Sandi-Awal-Yang-Kuat-123

# Backup otomatis
BACKUP_INTERVAL_HOURS=24
KEEP_DAILY=7
KEEP_WEEKLY=4
