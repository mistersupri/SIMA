# Salin ke .env. `pnpm dev` membuatnya otomatis bila belum ada.
NODE_ENV=development

# Database (dipakai docker-compose dan API)
POSTGRES_USER=sima
POSTGRES_PASSWORD=sima_dev_password
POSTGRES_DB=sima
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sima:sima_dev_password@localhost:5432/sima?schema=public

# Server
API_PORT=3001
WEB_PORT=5173
# URL publik aplikasi (dipakai di isi QR Code dan tautan). Produksi: https://domain-instansi
APP_URL=http://localhost:5173

# Session & keamanan
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
SESSION_TTL_HOURS=12
# Wajib true di produksi (HTTPS)
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# File (private storage, tidak disajikan statis)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Bootstrap Super Admin (dibuat oleh seed bila belum ada)
ORG_CODE=INSTANSI
ORG_NAME=Nama Instansi
BOOTSTRAP_ADMIN_EMAIL=admin@sima.local
BOOTSTRAP_ADMIN_NAME=Super Admin
# Ganti segera setelah login pertama. Seed menandai akun wajib ganti password.
BOOTSTRAP_ADMIN_PASSWORD=Ganti-Password-Ini-123
